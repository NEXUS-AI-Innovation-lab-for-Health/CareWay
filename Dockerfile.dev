# ================================
# Dockerfile pour le développement
# ================================
FROM node:20-alpine

# Métadonnées
LABEL maintainer="CareWay Team"
LABEL description="CareWay - Environnement de développement"

# Installer les outils de développement
RUN apk add --no-cache \
    git \
    curl

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json package-lock.json* .npmrc ./

# --- Configuration pour les packages JSR (redondant avec .npmrc mais plus sûr) ---
RUN npm config set @jsr:registry https://npm.jsr.io

# Installer toutes les dépendances (dev + prod)
RUN npm install

# Copier le reste du code
COPY . .

# Exposer le port Vite (configuré à 3000)
EXPOSE 3000

# Créer un utilisateur non-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

# Changer l'utilisateur
USER nodejs

# Commande par défaut: démarrer le serveur de développement
CMD ["npm", "run", "dev"]
