# ================================
# CareWay - Variables d'environnement
# Environnement de développement avec Supabase local
# ================================

# Mode de l'application
NODE_ENV=development

# ================================
# Configuration Supabase Local (Docker)
# ================================

# URL de l'API Supabase locale (via Kong Gateway sur Docker)
VITE_SUPABASE_URL=http://localhost:8000

# Clé anonyme Supabase (doit correspondre à celle dans docker/.env)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNhcmV3YXkiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYxNDYzMjc0MCwiZXhwIjoxOTMwMDMwNzQwfQ.N_l_e_i_o_n_s_k_e_y_h_e_r_e

# ================================
# Configuration PostgreSQL
# ================================
POSTGRES_DB=careway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secret-password

# ================================
# Configuration Supabase avancée
# ================================
# Secret JWT pour signer les tokens
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Clé Service Role (accès admin pour backend)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNhcmV3YXkiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjE0NjMyNzQwLCJleHAiOjE5MzAwMzA3NDB9.s_e_c_r_e_t_k_e_y_h_e_r_e
