# ================================
# CareWay - Variables d'environnement
# Environnement de développement avec Supabase local
# ================================

# Mode de l'application
NODE_ENV=development

# ================================
# Configuration Supabase Local (Docker)
# ================================
# Ces valeurs sont les clés par défaut de Supabase en mode développement
# NE PAS utiliser en production!

# URL de l'API Supabase locale (via Docker)
VITE_SUPABASE_URL=http://localhost:54321

# Clé anonyme Supabase (valeur par défaut pour le développement local)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ================================
# Configuration PostgreSQL (Container Supabase)
# ================================
POSTGRES_DB=careway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ================================
# Configuration Supabase avancée (optionnel)
# ================================
# Secret JWT pour signer les tokens
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Clé Service Role (accès admin pour backend)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
