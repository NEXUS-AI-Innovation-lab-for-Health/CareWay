# ================================
# CareWay - Variables d'environnement
# ================================

# Mode de l'application
NODE_ENV=development

# Configuration Supabase (OBLIGATOIRE)
# Remplacez par vos vraies valeurs Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-clé-anonyme-supabase-ici

# Optionnel : Configuration Supabase Service Role (backend uniquement)
# SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Port de développement (optionnel, par défaut 3000)
# PORT=3000
