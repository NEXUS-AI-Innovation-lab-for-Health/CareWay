# ================================
# CareWay - .gitignore
# ================================

# ================================
# Dependencies
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ================================
# Build outputs
# ================================
build/
dist/
*.local

# ================================
# Environment variables
# ================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ================================
# Docker
# ================================
# Fichier de personnalisation locale (ne pas commiter)
docker-compose.override.yml

# Logs Docker
docker-compose.log

# ================================
# IDE / Editors
# ================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ================================
# OS specific
# ================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ================================
# Testing
# ================================
coverage/
.nyc_output/
*.lcov

# ================================
# Logs
# ================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ================================
# Temporary files
# ================================
tmp/
temp/
*.tmp
*.bak
*.cache

# ================================
# TypeScript
# ================================
*.tsbuildinfo

# ================================
# Misc
# ================================
.eslintcache
.stylelintcache
.parcel-cache
